; Same names and ordinals as C:\Windows\System32\dxgi.dll (Build 26300).
; The stub number is ordinal - 1. kExports in dxgi_proxy.cpp uses the same order.
LIBRARY dxgi
EXPORTS
    ApplyCompatResolutionQuirking=proxy_stub_0 @1
    CompatString=proxy_stub_1 @2
    CompatValue=proxy_stub_2 @3
    DXGIDumpJournal=proxy_stub_3 @4
    PIXBeginCapture=proxy_stub_4 @5
    PIXEndCapture=proxy_stub_5 @6
    PIXGetCaptureState=proxy_stub_6 @7
    SetAppCompatStringPointer=proxy_stub_7 @8
    UpdateHMDEmulationStatus=proxy_stub_8 @9
    CreateDXGIFactory=proxy_stub_9 @10
    CreateDXGIFactory1=proxy_stub_10 @11
    CreateDXGIFactory2=proxy_stub_11 @12
    DXGID3D10CreateDevice=proxy_stub_12 @13
    DXGID3D10CreateLayeredDevice=proxy_stub_13 @14
    DXGID3D10GetLayeredDeviceSize=proxy_stub_14 @15
    DXGID3D10RegisterLayers=proxy_stub_15 @16
    DXGIDeclareAdapterRemovalSupport=proxy_stub_16 @17
    DXGIDisableVBlankVirtualization=proxy_stub_17 @18
    DXGIGetDebugInterface1=proxy_stub_18 @19
    DXGIReportAdapterConfiguration=proxy_stub_19 @20
